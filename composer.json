{
    "name": "masilia/ibexa-ai-editor",
    "description": "AI help inside the Ibexa content editing form: suggestions for each field and image generation",
    "keywords": [
        "ibexa",
        "ibexa-dxp",
        "ibexa-5",
        "symfony-bundle",
        "ai",
        "content-editing",
        "suggestions",
        "image-generation"
    ],
    "homepage": "https://github.com/MasiliaLabs/ibexa-ai-editor",
    "license": "MIT",
    "authors": [
        {
            "name": "MasiliaLabs",
            "homepage": "https://github.com/MasiliaLabs"
        }
    ],
    "support": {
        "issues": "https://github.com/MasiliaLabs/ibexa-ai-editor/issues",
        "source": "https://github.com/MasiliaLabs/ibexa-ai-editor",
        "security": "https://github.com/MasiliaLabs/ibexa-ai-editor/security/policy"
    },
    "type": "ibexa-bundle",
    "require": {
        "php": ">=8.3",
        "ibexa/admin-ui": "^5.0",
        "ibexa/core": "^5.0",
        "masilia/ibexa-ai": "^2.0",
        "neuron-core/neuron-ai": "^4.1",
        "psr/log": "^3.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4"
    },
    "require-dev": {
        "ibexa/fieldtype-matrix": "^5.0",
        "ibexa/fieldtype-richtext": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Masilia\\IbexaAiEditor\\": "src/lib/",
            "Masilia\\Bundle\\IbexaAiEditor\\": "src/bundle/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Masilia\\IbexaAiEditor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpunit": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": [
            "@phpunit",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "*": false
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
